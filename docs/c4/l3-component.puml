@startuml
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title AulaViva - C4 L3 - Componentes de la aplicacion web

Person(usuario, "Usuario", "Profesor, estudiante, apoderado o administrador.")

Container_Ext(navegador, "Navegador", "HTML / CSS / JavaScript", "Interfaz web y formularios.")

ContainerDb_Ext(db, "PostgreSQL + pgvector", "PostgreSQL", "Datos academicos, materiales, fragmentos y embeddings.")

System_Ext(ollama, "Ollama", "nomic-embed-text y qwen3:1.7b.")

Container_Boundary(app, "Aplicacion web AulaViva - Apache y PHP 8.4") {

    Component(auth, "Autenticacion y autorizacion", "PHP", "Sesiones, roles, colegio y permisos.")

    Component(aulas, "Aulas y cursos", "PHP", "Consulta de aulas, cursos, matriculas y alumnos.")

    Component(materiales, "Materiales educativos", "PHP", "Carga y consulta autorizada de archivos PDF.")

    Component(evaluaciones, "Gestion de evaluaciones", "PHP", "Creacion, edicion y publicacion de evaluaciones.")

    Component(rendicion, "Rendicion y autocorreccion", "PHP", "Respuestas, puntajes, calificaciones y eventos Outbox.")

    Component(tutor, "Tutor IA", "PHP", "Orquesta la recuperacion y generacion de respuestas.")

    Component(retriever, "Recuperador hibrido", "TutorRetriever", "Recupera fragmentos autorizados mediante busqueda textual y vectorial.")

    Component(evidence, "Validacion de evidencia", "EvidenceGate", "Extrae hechos explicitos y controla afirmaciones y citas.")

    Component(provider, "Proveedor de IA", "AIProvider / Embeddings", "Comunica la aplicacion con Ollama.")

    Component(apoderados, "Panel y vinculaciones", "PHP", "Consulta de rendimiento y gestion de vinculos autorizados.")

    Component(invitaciones, "Invitaciones y activacion", "PHP", "Emision y consumo transaccional de invitaciones.")

    Component(api, "API REST", "PHP / JSON", "Endpoints de autenticacion, aulas e invitaciones.")

    Component(pdo, "Conexion y persistencia", "PDO PostgreSQL", "Acceso a la base de datos.")
}

Rel(usuario, navegador, "Utiliza")

Rel(navegador, auth, "Inicia sesion")
Rel(navegador, aulas, "Consulta aulas y cursos")
Rel(navegador, materiales, "Gestiona materiales")
Rel(navegador, evaluaciones, "Gestiona evaluaciones")
Rel(navegador, rendicion, "Rinde y consulta resultados")
Rel(navegador, tutor, "Formula preguntas")
Rel(navegador, apoderados, "Consulta rendimiento y vinculos")
Rel(navegador, invitaciones, "Gestiona invitaciones")
Rel(navegador, api, "Solicitudes HTTP/JSON cuando corresponde")

Rel(aulas, auth, "Comprueba permisos")
Rel(materiales, auth, "Comprueba permisos")
Rel(evaluaciones, auth, "Comprueba permisos")
Rel(rendicion, auth, "Comprueba permisos")
Rel(tutor, auth, "Comprueba matricula y acceso")
Rel(apoderados, auth, "Comprueba rol y acceso")
Rel(invitaciones, auth, "Comprueba permisos de emision")
Rel(api, auth, "Valida sesion y permisos")

Rel(tutor, retriever, "Recupera evidencia autorizada")
Rel(tutor, evidence, "Prepara y valida afirmaciones")
Rel(tutor, provider, "Solicita generacion")
Rel(retriever, provider, "Solicita embeddings")
Rel(provider, ollama, "Inferencia local", "HTTP/JSON")

Rel(auth, pdo, "Consulta usuarios")
Rel(aulas, pdo, "Consulta aulas y alumnos")
Rel(materiales, pdo, "Lee y guarda materiales")
Rel(evaluaciones, pdo, "Gestiona evaluaciones")
Rel(rendicion, pdo, "Persiste entregas, resultados y Outbox")
Rel(retriever, pdo, "Consulta fragmentos y vectores")
Rel(apoderados, pdo, "Consulta y gestiona vinculos")
Rel(invitaciones, pdo, "Gestiona invitaciones")
Rel(api, pdo, "Ejecuta consultas autorizadas")

Rel(pdo, db, "Consultas SQL y transacciones", "PDO PostgreSQL")

@enduml