@startuml C4_Nivel1_Contexto
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title AulaViva - Contexto del sistema (C4 L1) - Implementacion en main f908f01

Person(estudiante, "Estudiante", "Consulta materiales de sus aulas, rinde evaluaciones y utiliza el Tutor IA.")
Person(docente, "Profesor / docente", "Consulta sus aulas y alumnos, sube materiales, crea y publica evaluaciones y emite invitaciones.")
Person(apoderado, "Apoderado", "Consulta asignaturas, promedios y ultimas evaluaciones de estudiantes con vinculo confirmado.")
Person(admin, "Administrador", "Gestiona y confirma vinculos apoderado-estudiante dentro de su colegio.")

System(aulaviva, "AulaViva", "Aplicacion educativa con autenticacion por sesion, roles y autorizacion por colegio, aula y vinculo.")
System_Ext(ollama, "Ollama", "Servicio local de embeddings y generacion para el Tutor IA; sin API de pago.")

Rel(estudiante, aulaviva, "Consulta materiales, rinde evaluaciones y formula preguntas al Tutor", "Web")
Rel(docente, aulaviva, "Publica materiales y evaluaciones; invita a crear cuentas", "Web")
Rel(apoderado, aulaviva, "Consulta rendimiento academico autorizado", "Web")
Rel(admin, aulaviva, "Gestiona y confirma vinculaciones", "Web")
Rel(aulaviva, ollama, "Solicita embeddings y respuestas con evidencia recuperada de materiales autorizados", "HTTP/JSON")

@enduml
